{
  "name": "accounting-timer",
  "private": true,
  "version": "0.0.0",
  "description": "Accounting Workload & Profitability Management System — Gate A practice prototype",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm run --parallel --filter @accounting-timer/api --filter @accounting-timer/web dev",
    "dev:api": "pnpm --filter @accounting-timer/api dev",
    "dev:web": "pnpm --filter @accounting-timer/web dev",
    "dev:desktop": "pnpm --filter @accounting-timer/desktop dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @accounting-timer/shared-types build && pnpm --filter @accounting-timer/web build",
    "package:desktop": "pnpm build:web && pnpm --filter @accounting-timer/desktop package",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test && pnpm test:scripts",
    "lint": "pnpm -r run lint",
    "check:node": "node scripts/check-node.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:ps": "docker compose ps",
    "db:seed": "pnpm --filter @accounting-timer/api db:seed:demo",
    "db:seed:demo": "pnpm --filter @accounting-timer/api db:seed:demo",
    "verify:phase0": "node scripts/verify-phase0.mjs",
    "verify:electron-poc": "node scripts/verify-electron-poc.mjs",
    "verify:electron-poc:package": "node scripts/verify-electron-poc.mjs --package",
    "test:scripts": "node --test scripts/**/*.test.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "electron", "electron-builder"]
  }
}
