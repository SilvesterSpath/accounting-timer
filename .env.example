# Copy to .env for local development (never commit secrets).
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgresql://accounting:accounting@127.0.0.1:5432/accounting_timer
# Comma-separated allowlist (web + Electron app:// origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,app://-,app://accounting-timer
