# Copy to .env for local development (never commit secrets).
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Railway injects PORT; local uses API_PORT / default 3001
# PORT=3001
DATABASE_URL=postgresql://accounting:accounting@127.0.0.1:5432/accounting_timer
# Isolated DB for API tests (docker compose service postgres_test)
TEST_DATABASE_URL=postgresql://accounting:accounting@127.0.0.1:5433/accounting_timer_test
# Required in production — development may omit and use a local fallback
JWT_SECRET=dev-only-change-me-accounting-timer-gate-a
# When set, this list REPLACES development CORS defaults (does not extend them).
# Canonical Electron origin: app://accounting-timer
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,app://accounting-timer

# --- Railway hosted demo (see docs/RAILWAY_DEMO.md) ---
# TRUST_PROXY=1
# ALLOW_DEMO_SEED=1
# DEMO_BOOTSTRAP=1
# DEMO_EMPLOYEE_PASSWORD=   # visitor-only secret
# DEMO_OPERATOR_PASSWORD=   # operator-only secret; never share with visitors
# WEB_DIST_DIR=/app/apps/web/dist

